   </dc:subject>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Sanit Saengkaew</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Cinematic top-down shot of a turntable stylus on a spinning black vinyl record, featuring sharp blue highlights and dramatic contrast.</rdf:li>
    </rdf:Alt>
   </dc:description>
